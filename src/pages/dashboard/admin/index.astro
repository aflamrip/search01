---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const user = (Astro.locals as any).user;
---

<BaseLayout title="لوحة المدير العام — Super Admin Panel">
  <div class="min-h-screen flex flex-col bg-slate-100 dark:bg-slate-950">
    <header class="bg-slate-900 text-white border-b border-slate-800 px-6 py-4">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <div class="flex items-center space-x-3 space-x-reverse">
          <a href="/dashboard" class="font-extrabold text-lg text-blue-400">Super Admin Panel</a>
          <span class="text-xs bg-amber-500/20 text-amber-300 px-2.5 py-0.5 rounded-full font-bold">صلاحية مدير النظام</span>
        </div>
        <div class="flex items-center gap-4 text-sm">
          <span class="text-slate-400">مرحباً، {user?.name || 'المدير العام'}</span>
          <a href="/dashboard" class="text-slate-300 hover:text-white">لوحة المشرفين</a>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="text-rose-400 hover:text-rose-300 font-medium">تسجيل الخروج</button>
          </form>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-6xl mx-auto w-full px-6 py-8">
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">إدارة نظام محرك البحث</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">التحكم الفائق في حسابات المستخدمين والمواجهات المسجلة وخرائط Sitemap</p>
      </div>

      <!-- Control Tabs & Tables -->
      <div class="space-y-8">
        <!-- Users Management Section -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
          <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
            <h2 class="font-bold text-base text-slate-900 dark:text-white">حسابات المشرفين والمستخدمين</h2>
            <span class="text-xs text-slate-500">إدارة الصلاحيات والتعليق</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-right">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 text-xs">
                <tr>
                  <th class="px-6 py-3">الاسم</th>
                  <th class="px-6 py-3">البريد الإلكتروني</th>
                  <th class="px-6 py-3">الرتبة</th>
                  <th class="px-6 py-3">حالة الحساب</th>
                  <th class="px-6 py-3">الإجراءات</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50">
                  <td class="px-6 py-4 font-medium text-slate-900 dark:text-white">مدير النظام الرئيسي</td>
                  <td class="px-6 py-4 text-slate-500" dir="ltr text-right">admin@searchengine.dev</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300">
                      super_admin
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300">
                      نشط
                    </span>
                  </td>
                  <td class="px-6 py-4 text-xs text-slate-400">حساب محمي</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Sites Control Section -->
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden shadow-sm">
          <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex justify-between items-center">
            <h2 class="font-bold text-base text-slate-900 dark:text-white">المواقع المسجلة في المحرك</h2>
            <span class="text-xs text-slate-500">الموافقة والتعطيل والإشراف</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-right">
              <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 text-xs">
                <tr>
                  <th class="px-6 py-3">النطاق / اسم الموقع</th>
                  <th class="px-6 py-3">المالك</th>
                  <th class="px-6 py-3">حالة التوثيق</th>
                  <th class="px-6 py-3">حالة الزحف</th>
                  <th class="px-6 py-3">الإجراءات</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50">
                  <td class="px-6 py-4 font-mono text-xs font-semibold text-blue-600 dark:text-blue-400" dir="ltr text-right">
                    astro.build
                  </td>
                  <td class="px-6 py-4 text-slate-600 dark:text-slate-300">أحمد مشرف المواقع</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300">
                      متحقق منه
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300">
                      نشط
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    <button class="text-xs text-rose-600 hover:underline font-semibold">تعطيل الموقع</button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
