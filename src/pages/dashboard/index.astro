---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="لوحة تحكم مشرفي المواقع — Search Console Platform">
  <div class="min-h-screen flex flex-col bg-slate-100 dark:bg-slate-950">
    <header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-6 py-4">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <div class="flex items-center space-x-3 space-x-reverse">
          <a href="/" class="font-bold text-lg text-blue-600 dark:text-blue-400">Webmaster Console</a>
          <span class="text-xs bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 px-2 py-0.5 rounded-full font-medium">V4 Beta</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="/" class="text-sm text-slate-500 hover:text-slate-800 dark:hover:text-slate-200">الرجوع للبحث</a>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="text-sm text-rose-500 hover:text-rose-700 dark:hover:text-rose-400 font-medium transition-colors">
              تسجيل الخروج
            </button>
          </form>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-6xl mx-auto w-full px-6 py-8">
      <div class="flex justify-between items-center mb-8">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 dark:text-white">المواقع المسجلة</h1>
          <p class="text-sm text-slate-500 dark:text-slate-400">إدارة المواقع، خرائط Sitemap، ومراقبة حالة الفهرسة</p>
        </div>
        <button class="bg-blue-600 hover:bg-blue-700 text-white text-sm px-4 py-2 rounded-lg font-medium shadow-sm transition-all">
          + إضافة موقع جديد
        </button>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl">
          <div class="text-xs text-slate-500 mb-1">إجمالي المواقع</div>
          <div class="text-2xl font-bold text-slate-900 dark:text-white">3</div>
        </div>
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl">
          <div class="text-xs text-slate-500 mb-1">الصفحات المفهرسة</div>
          <div class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">14,250</div>
        </div>
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl">
          <div class="text-xs text-slate-500 mb-1">الصفحات القيد المعالجة</div>
          <div class="text-2xl font-bold text-amber-600 dark:text-amber-400">820</div>
        </div>
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 rounded-xl">
          <div class="text-xs text-slate-500 mb-1">أخطاء الفهرسة</div>
          <div class="text-2xl font-bold text-rose-600 dark:text-rose-400">12</div>
        </div>
      </div>

      <!-- Sites Table -->
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-800 font-semibold text-sm">
          قائمة المواقع الخاصة بك
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-right">
            <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 text-xs uppercase">
              <tr>
                <th class="px-6 py-3">الموقع / النطاق</th>
                <th class="px-6 py-3">حالة التحقق</th>
                <th class="px-6 py-3">خرائط Sitemap</th>
                <th class="px-6 py-3">آخر زحف</th>
                <th class="px-6 py-3">الإجراءات</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50">
                <td class="px-6 py-4 font-medium text-slate-900 dark:text-white" dir="ltr text-right">
                  astro.build
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 dark:bg-emerald-900/50 text-emerald-800 dark:text-emerald-300">
                    متحقق منه
                  </span>
                </td>
                <td class="px-6 py-4 text-slate-600 dark:text-slate-300">2 خرائط</td>
                <td class="px-6 py-4 text-slate-500">قبل ساعتين</td>
                <td class="px-6 py-4">
                  <a href="/dashboard/sites/1" class="text-blue-600 dark:text-blue-400 hover:underline text-xs font-semibold">التفاصيل ←</a>
                </td>
              </tr>
              <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50">
                <td class="px-6 py-4 font-medium text-slate-900 dark:text-white" dir="ltr text-right">
                  svelte.dev
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 dark:bg-emerald-900/50 text-emerald-800 dark:text-emerald-300">
                    متحقق منه
                  </span>
                </td>
                <td class="px-6 py-4 text-slate-600 dark:text-slate-300">1 خريطة</td>
                <td class="px-6 py-4 text-slate-500">قبل يومين</td>
                <td class="px-6 py-4">
                  <a href="/dashboard/sites/2" class="text-blue-600 dark:text-blue-400 hover:underline text-xs font-semibold">التفاصيل ←</a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
